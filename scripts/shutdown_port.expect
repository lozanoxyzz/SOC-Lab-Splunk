#!/usr/bin/expect -f
# Usage: shutdown_port.expect <switch_ip> <interface> <password>
# Handles the interactive IOS session (enable -> conf t -> shutdown)

set switch   [lindex $argv 0]
set port     [lindex $argv 1]
set password [lindex $argv 2]

spawn sshpass -p $password ssh -i /opt/splunk/.ssh/id_rsa -oKexAlgorithms=+diffie-hellman-group14-sha1 -oHostKeyAlgorithms=+ssh-rsa -oStrictHostKeyChecking=no admin@$switch

expect ">"
send "enable\r"
expect "Password:"
send "$password\r"
expect "#"
send "conf t\r"
expect "(config)#"
send "interface $port\r"
expect "(config-if)#"
send "shutdown\r"
expect "(config-if)#"
send "end\r"
expect "#"
send "exit\r"
